{
  "APP_ENV": { "required": true, "type": "enum", "enum": ["development", "test", "production"] },
  "PORT": { "required": true, "type": "integer", "min": 1, "max": 65535 },
  "DEBUG": { "required": true, "type": "boolean" },
  "DATABASE_URL": { "required": true, "type": "url" },
  "API_TOKEN": { "required": true, "type": "string", "secret": true, "min_length": 12 }
}

